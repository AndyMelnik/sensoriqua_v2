#!/bin/sh
# Strip tooling trailers from commit messages (Co-authored-by, Made-with).
# Install: cp scripts/prepare-commit-msg .git/hooks/prepare-commit-msg && chmod +x .git/hooks/prepare-commit-msg

msg_file="$1"
[ -z "$msg_file" ] || [ ! -f "$msg_file" ] && exit 0

tmp=$(mktemp)
# Drop common AI/tooling trailers so they are not published in public history
grep -v -iE '^(Co-authored-by:|Made-with:)' "$msg_file" > "$tmp" && mv "$tmp" "$msg_file"
rm -f "$tmp"
exit 0
