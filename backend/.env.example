# Copy to .env and set your DSN. Never commit .env.
# SENSORIQUA_DSN=postgresql://user:password@host:port/database?sslmode=require

# Navixy App Connect (optional): set to enable POST /api/auth/login and Bearer auth.
# Generate a random secret (min 32 chars): e.g. openssl rand -hex 32
# JWT_SECRET=your-secret-at-least-32-characters-long

# Optional shared secret for POST /api/auth/login (header X-Sensoriqua-Login-Key).
# Recommended when the login endpoint is reachable from the network.
# LOGIN_API_KEY=

# Max login attempts per client IP per minute (default 30).
# LOGIN_RATE_LIMIT_PER_MINUTE=30

# Trust X-Forwarded-For for client IP (login rate limit) only behind a reverse proxy
# that sets/overwrites that header. Leave unset when the app is exposed directly.
# TRUST_PROXY=0

# Persist App Connect DSNs across restarts (default: backend/sensoriqua_credentials.json).
# SENSORIQUA_CREDENTIALS_PATH=

# CORS: comma-separated origins when using Bearer auth (required for cross-origin frontend).
# Example: https://app.example.com,https://admin.example.com
# When JWT_SECRET is set and this is empty, cross-origin browser calls are blocked (same-origin OK).
# CORS_ORIGINS=

# Only in trusted environments: allow login/client DSNs to localhost/private IPs (default: no).
# Operator SENSORIQUA_DSN from this file is always allowed (still hostaddr-pinned).
# ALLOW_PRIVATE_DSN=0

# Standalone only — opt-in client overrides (disabled by default; enables IDOR / DB selection risk):
# ALLOW_CLIENT_DSN=0
# ALLOW_CLIENT_USER_ID=0

# Iframe: by default the app can be embedded anywhere. To restrict: comma-separated origins.
# To disable embedding: ALLOW_FRAME_ORIGINS=deny
# ALLOW_FRAME_ORIGINS=
